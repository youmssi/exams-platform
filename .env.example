# Copy to .env.local and fill in. Never commit real values.

# App
APP_URL=http://localhost:3000

# Database (Neon) — EXM-002
DATABASE_URL=

# Auth (Better Auth) — EXM-002
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Encryption of exam-centre passwords (32 random bytes, base64: openssl rand -base64 32)
CREDENTIALS_ENCRYPTION_KEY=

# Email (Resend) — EXM-002
RESEND_API_KEY=
EMAIL_FROM=

# Realtime and presence (Ably) — EXM-006. Optional: without it, the queue refreshes every 15 s.
ABLY_API_KEY=

# Private files (Vercel Blob, private store) — EXM-010. Set by Vercel when the store is connected.
BLOB_READ_WRITE_TOKEN=

# Monitoring (Sentry) — EXM-013
SENTRY_DSN=

# Analytics (Umami, public values) — production only
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_DOMAINS=
