// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String                @id
  name             String
  email            String
  emailVerified    Boolean               @default(false)
  image            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  twoFactorEnabled Boolean?              @default(false)
  role             String?
  banned           Boolean?              @default(false)
  banReason        String?
  banExpires       DateTime?
  activeRole       String?               @default("candidate")
  termsAcceptedAt  DateTime?
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]
  beneficiaries    Beneficiary[]
  sessionsCreated  ExamSession[]
  confirmations    SessionConfirmation[]
  requests         Request[]
  catalogRequests  CatalogRequest[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String    @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?
  secondFactorAt DateTime?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

/// A country where exams are booked. Its name is localized from `code` (ISO 3166-1 alpha-2).
model Country {
  id        String   @id @default(cuid())
  code      String   @unique
  currency  String
  timeZone  String
  active    Boolean  @default(true)
  centers   Center[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("country")
}

model Center {
  id          String   @id @default(cuid())
  countryId   String
  country     Country  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  name        String
  city        String
  officialUrl String
  active      Boolean  @default(true)
  offers      Offer[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([countryId, name])
  @@map("center")
}

/// A level offered by a center (e.g. Goethe Yaoundé B1) with its economic settings.
/// Amounts are integers in the country's currency unit; the commission rate is in basis points.
model Offer {
  id                String        @id @default(cuid())
  centerId          String
  center            Center        @relation(fields: [centerId], references: [id], onDelete: Restrict)
  level             String
  modules           String[]
  standardPrice     Int
  commissionRateBp  Int
  commissionMin     Int
  bonusStep         Int
  bonusCap          Int
  claimTimeoutMin   Int
  confirmOnlineMin  Int
  confirmOfflineMin Int
  paymentDeadlineH  Int
  active            Boolean       @default(true)
  sessions          ExamSession[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([centerId, level])
  @@map("offer")
}

/// Every admin action, with the state before and after.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@map("audit_log")
}

/// A person the account holder books for: themself ("self") or a friend who agreed.
/// The exam-centre password is encrypted (AES-256-GCM) and never sent back to the owner.
model Beneficiary {
  id             String    @id @default(cuid())
  ownerId        String
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isSelf         Boolean   @default(false)
  fullName       String
  email          String
  passwordCipher String?
  consentAt      DateTime?
  requests       Request[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([ownerId])
  @@map("beneficiary")
}

/// An exam date for an offer, created by any user. Confirmed after 3 confirmations or by an admin.
model ExamSession {
  id                  String                @id @default(cuid())
  offerId             String
  offer               Offer                 @relation(fields: [offerId], references: [id], onDelete: Restrict)
  examDate            DateTime              @db.Date
  registrationOpensAt DateTime
  officialUrl         String?
  verifiedAt          DateTime?
  createdById         String
  createdBy           User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  confirmations       SessionConfirmation[]
  requests            Request[]
  createdAt           DateTime              @default(now())

  @@unique([offerId, examDate])
  @@map("exam_session")
}

model SessionConfirmation {
  sessionId String
  session   ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@id([sessionId, userId])
  @@map("session_confirmation")
}

enum RequestStatus {
  OPEN
  CANCELLED
}

/// A booking request for one beneficiary and one session.
/// Visible in the queue once `publishAt` has passed; the price is frozen at creation.
model Request {
  id             String        @id @default(cuid())
  sessionId      String
  session        ExamSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  beneficiaryId  String
  beneficiary    Beneficiary   @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  ownerId        String
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status         RequestStatus @default(OPEN)
  publishAt      DateTime
  currency       String
  standardPrice  Int
  bonus          Int
  total          Int
  commission     Int
  assistantShare Int
  version        Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([sessionId, status, publishAt])
  @@index([ownerId])
  @@map("request")
}

enum CatalogRequestKind {
  COUNTRY
  CENTER
  LEVEL
  OTHER
}

/// A user asks the admins to add a country, a centre or a level.
model CatalogRequest {
  id          String             @id @default(cuid())
  requesterId String
  requester   User               @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  kind        CatalogRequestKind
  details     String
  officialUrl String?
  handledAt   DateTime?
  createdAt   DateTime           @default(now())

  @@map("catalog_request")
}
